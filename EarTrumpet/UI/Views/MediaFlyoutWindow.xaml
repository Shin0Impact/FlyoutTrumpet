<Window x:Class="EarTrumpet.UI.Views.MediaFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
        Title="EarTrumpet Now Playing"
        Width="380"
        Theme:Brush.Foreground="Text"
        Theme:Options.Scope="Flyout"
        Theme:Options.Source="System"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Theme:Brush.Foreground" Value="Theme=Text, HighContrast=ControlText" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33808080" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22808080" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Theme:Brush.Background="FlyoutBackground">
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="88"
                    Height="88"
                    Margin="0,0,14,0"
                    Background="#22808080"
                    CornerRadius="6">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="40"
                               Opacity="0.6"
                               Theme:Brush.Foreground="Text"
                               Text="&#xE8D6;" />
                    <Border x:Name="ThumbnailBorder" CornerRadius="6" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Theme:Brush.Foreground="Text"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText"
                           Margin="0,2,0,0"
                           FontSize="12"
                           Opacity="0.7"
                           Theme:Brush.Foreground="Text"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button x:Name="PrevButton"
                            Click="PrevButton_Click"
                            Content="&#xE892;"
                            Style="{StaticResource MediaButton}" />
                    <Button x:Name="PlayPauseButton"
                            Click="PlayPauseButton_Click"
                            Content="&#xE768;"
                            Style="{StaticResource MediaButton}" />
                    <Button x:Name="NextButton"
                            Click="NextButton_Click"
                            Content="&#xE893;"
                            Style="{StaticResource MediaButton}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7"
                           Theme:Brush.Foreground="Text"
                           Text="0:00" />
                <ProgressBar x:Name="TimelineBar"
                             Grid.Column="1"
                             Height="4"
                             Margin="10,0"
                             Theme:Brush.Background="Theme=#40808080, HighContrast=Window"
                             BorderThickness="0"
                             Theme:Brush.Foreground="Theme=SystemAccent, HighContrast=Highlight"
                             Maximum="1" />
                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7"
                           Theme:Brush.Foreground="Text"
                           Text="0:00" />
            </Grid>
        </Grid>
    </Border>
</Window>
